# Copy this file to .env before running: docker compose up -d --build
# NEVER commit your real .env file to version control!

ASPNETCORE_ENVIRONMENT=Production
ENABLE_SWAGGER=false
PUBLIC_ORIGIN=http://localhost:8080

# Ports exposed on the Docker host
WEB_PORT=8080
API_PORT=5019
SQL_PORT=14330

# Strong SQL Server SA password (must include upper, lower, digit, symbol, >= 8 chars)
MSSQL_SA_PASSWORD=ChangeMe_StrongSqlPass#2026!

# Cryptographically random JWT signing key (minimum 32+ characters)
JWT_KEY=ReplaceWith_64Char_Random_Production_JWT_Secret_Key_ChangeMeNow!
JWT_ISSUER=SarkariExamIntelligence
JWT_AUDIENCE=SarkariExamIntelligenceClient
JWT_EXPIRY_MINUTES=720

# Optional SMTP configuration for deadline email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=true
SMTP_FROM=alerts@sarkariexamintelligence.in
SMTP_USER=
SMTP_PASSWORD=
